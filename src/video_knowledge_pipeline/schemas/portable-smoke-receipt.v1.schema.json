{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lightcoloror/video-knowledge-pipeline/schemas/portable-smoke-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "fixture_sha256", "material_manifest", "gateway_mock", "artifacts", "capability_truth", "boundaries", "receipt_sha256"],
  "properties": {
    "schema": {"const": "video_knowledge_pipeline.portable_smoke_receipt.v1"},
    "schema_version": {"const": "1.0"},
    "status": {"const": "completed"},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "material_manifest": {"type": "object"},
    "gateway_mock": {"type": "object"},
    "artifacts": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "bytes", "sha256"], "properties": {"role": {"type": "string"}, "path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "capability_truth": {"type": "object"},
    "boundaries": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
